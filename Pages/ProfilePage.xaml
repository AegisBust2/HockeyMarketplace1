<Page x:Class="HockeyMarketplace.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FA">
    <Grid Margin="28">
        <Border Width="650" HorizontalAlignment="Left" Background="White" Padding="28" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Личный кабинет" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Ваши контактные данные" Foreground="#64748B" Margin="0,6,0,20"/>
                <TextBlock Text="ФИО"/><TextBox x:Name="NameBox"/>
                <TextBlock Text="Телефон" Margin="0,10,0,0"/><TextBox x:Name="PhoneBox"/>
                <TextBlock Text="Email" Margin="0,10,0,0"/><TextBox x:Name="EmailBox"/>
                <TextBlock Text="Роль" Margin="0,10,0,0"/><TextBox x:Name="RoleBox" IsReadOnly="True"/>
                <Button Content="Сохранить изменения" Height="44" Margin="4,22,4,4" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
