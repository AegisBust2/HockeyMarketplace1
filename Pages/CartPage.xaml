<Page x:Class="HockeyMarketplace.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Корзина" FontSize="30" FontWeight="Bold" Margin="0,0,0,18"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CartList"/>
            </ScrollViewer>
        </StackPanel>

        <Border Grid.Column="1" Background="White" Margin="22,0,0,0" Padding="22" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Оформление заказа" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Выберите способ получения" Margin="0,18,0,4"/>
                    <ComboBox x:Name="DeliveryBox" SelectedIndex="0">
                        <ComboBoxItem>Курьер</ComboBoxItem>
                        <ComboBoxItem>Самовывоз</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Адрес доставки" Margin="0,12,0,4"/>
                    <TextBox x:Name="AddressBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock Text="Способ оплаты" Margin="0,12,0,4"/>
                    <ComboBox x:Name="PaymentBox" SelectedIndex="0">
                        <ComboBoxItem>Банковская карта</ComboBoxItem>
                        <ComboBoxItem>Наличные</ComboBoxItem>
                        <ComboBoxItem>Безналичный расчёт</ComboBoxItem>
                        <ComboBoxItem>Онлайн-оплата</ComboBoxItem>
                    </ComboBox>
                    <Separator Margin="0,20"/>
                    <TextBlock Text="Итого" Foreground="#64748B"/>
                    <TextBlock x:Name="TotalText" Text="0 ₽" FontSize="28" FontWeight="Bold" Margin="0,3,0,16"/>
                    <Button Content="Оформить выбранные товары" Height="46" Click="Checkout_Click"/>
                    <TextBlock Text="Заказ оформляется только для отмеченных товаров." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
