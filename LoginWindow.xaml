<Window x:Class="HockeyMarketplace.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hockey Market — Вход" Height="560" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Border Background="#123E78">
            <StackPanel VerticalAlignment="Center" Margin="60">
                <TextBlock Text="HOCKEY MARKET" Foreground="White" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="Магазин хоккейной экипировки" Foreground="#DCEBFF" FontSize="18" Margin="0,12,0,0"/>
                <TextBlock Text="Коньки • клюшки • защита • аксессуары" Foreground="#BBD4F5" FontSize="14" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" Padding="55">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Введите данные для входа" Foreground="#64748B" Margin="0,8,0,20"/>
                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailBox" />
                <TextBlock Text="Пароль" Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox"/>
                <Button Content="Войти" Height="44" Margin="4,20,4,6" Click="Login_Click" IsDefault="True"/>
                <Button Content="Создать аккаунт" Background="Transparent" Foreground="#1E5AA8" Click="Register_Click"/>
                <TextBlock Text="Демо: admin@hockey.ru / admin123" Foreground="#94A3B8" FontSize="12" Margin="4,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
