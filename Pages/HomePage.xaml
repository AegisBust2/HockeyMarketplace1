<Page x:Class="HockeyMarketplace.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FA">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Хоккейная экипировка" FontSize="30" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Выбирайте экипировку для тренировок и матчей" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="330" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию, артикулу и бренду"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,10">
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <ComboBox x:Name="CategoryBox" Width="190" SelectionChanged="FilterChanged"/>
            <TextBlock Text="Бренд:" VerticalAlignment="Center" Margin="18,0,8,0"/>
            <ComboBox x:Name="BrandBox" Width="160" SelectionChanged="FilterChanged"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
