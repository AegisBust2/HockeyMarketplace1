<Window x:Class="HockeyMarketplace.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Border Background="White" Margin="24" Padding="30">
        <StackPanel>
            <TextBlock Text="Создание аккаунта" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Заполните основные данные" Foreground="#64748B" Margin="0,6,0,18"/>
            <TextBlock Text="ФИО"/><TextBox x:Name="NameBox"/>
            <TextBlock Text="Телефон" Margin="0,8,0,0"/><TextBox x:Name="PhoneBox"/>
            <TextBlock Text="Email" Margin="0,8,0,0"/><TextBox x:Name="EmailBox"/>
            <TextBlock Text="Пароль" Margin="0,8,0,0"/><PasswordBox x:Name="PasswordBox"/>
            <Button Content="Зарегистрироваться" Height="44" Margin="4,20,4,4" Click="Register_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
