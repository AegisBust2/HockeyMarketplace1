<Page x:Class="HockeyMarketplace.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FA">
    <Grid Margin="28">
        <TabControl>
            <TabItem Header="Товары">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить товар" Click="AddProduct_Click"/>
                        <Button Content="Редактировать" Click="EditProduct_Click"/>
                        <Button Content="Удалить" Click="DeleteProduct_Click" Background="#B91C1C"/>
                        <Button Content="Обновить" Click="Refresh_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Background="White" Margin="0,12,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="250"/>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="110"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="130"/>
                            <DataGridTextColumn Header="Бренд" Binding="{Binding Brand.Name}" Width="120"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding RetailPrice, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Пользователи">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Заблокировать / разблокировать" Click="ToggleBlock_Click"/>
                        <Button Content="Обновить" Click="Refresh_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" Margin="0,12,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="240"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="140"/>
                            <DataGridCheckBoxColumn Header="Блокировка" Binding="{Binding IsBlocked}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Журнал действий">
                <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" Margin="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="170"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="220"/>
                        <DataGridTextColumn Header="Операция" Binding="{Binding Action}" Width="180"/>
                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
