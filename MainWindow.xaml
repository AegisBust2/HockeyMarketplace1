<Window x:Class="HockeyMarketplace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hockey Market" Height="850" Width="1400" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#123E78" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HOCKEY MARKET" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="Главная" Click="Home_Click" Background="Transparent" Margin="25,0,0,0"/>
                    <Button Content="Заказы" Click="Orders_Click" Background="Transparent"/>
                    <Button Content="Личный кабинет" Click="Profile_Click" Background="Transparent"/>
                    <Button x:Name="AdminButton" Content="Администрирование" Click="Admin_Click" Background="Transparent" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🛒  Корзина" Click="Cart_Click" Background="#1E5AA8" Padding="20,10"/>
            </Grid>
        </Border>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
