<Page x:Class="HockeyMarketplace.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FA">
    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="Мои заказы" FontSize="30" FontWeight="Bold" Margin="0,0,0,18"/>
            <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Получение" Binding="{Binding DeliveryMethod}" Width="140"/>
                    <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentMethod}" Width="180"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N0}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
